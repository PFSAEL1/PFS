{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/andreae-filters/?",
      "status": 301,
      "headers": {
        "Location": "/andreae-paint-booth-filters"
      }
    },
    {
      "src": "/product/test/?",
      "status": 301,
      "headers": { "Location": "/shop" }
    },
    {
      "src": "/product/platinum/?",
      "status": 301,
      "headers": { "Location": "/memberships" }
    },
    {
      "src": "/\\$",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(.+)/",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/((?!assets/|media/|fonts/|images/).*)",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=86400, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/filter-compatibility",
      "status": 308,
      "headers": {
        "Location": "/filter-finder"
      }
    },
    { "src": "^/light/?$", "status": 301, "headers": { "Location": "/" } },
    { "src": "^/light/shop/?$", "status": 301, "headers": { "Location": "/shop" } },
    { "src": "^/light/shop-by-type/?$", "status": 301, "headers": { "Location": "/shop-by-filter-type" } },
    { "src": "^/light/memberships/?$", "status": 301, "headers": { "Location": "/memberships" } },
    { "src": "^/light/contact/?$", "status": 301, "headers": { "Location": "/contact" } },
    { "src": "^/light/auth/?$", "status": 301, "headers": { "Location": "/auth" } },
    { "src": "^/light/why-choose-us/?$", "status": 301, "headers": { "Location": "/why-choose-us" } },
    { "src": "^/light/filter-database/?$", "status": 301, "headers": { "Location": "/filter-database" } },
    { "src": "^/light/filter-scanner/?$", "status": 301, "headers": { "Location": "/filter-scanner" } },
    { "src": "^/light/returns/?$", "status": 301, "headers": { "Location": "/returns" } },
    { "src": "^/light/privacy-policy/?$", "status": 301, "headers": { "Location": "/privacy-policy" } },
    { "src": "^/light(?:/.*)?$", "status": 301, "headers": { "Location": "/" } },
    { "src": "^/filters/?$", "status": 301, "headers": { "Location": "/paint-booth-filters" } },
    { "src": "^/paint-booth-filter/?$", "status": 301, "headers": { "Location": "/paint-booth-filters" } },
    { "src": "^/paint-booth-filter-wall/?$", "status": 301, "headers": { "Location": "/paint-booth-filters" } },
    { "src": "^/paintboothfilters/?$", "status": 301, "headers": { "Location": "/paint-booth-filters" } },
    { "src": "^/paint_booth_filters/?$", "status": 301, "headers": { "Location": "/paint-booth-filters" } },
    { "src": "^/paint-shop-filters/?$", "status": 301, "headers": { "Location": "/shop" } },
    { "src": "^/products/?$", "status": 301, "headers": { "Location": "/shop" } },
    { "src": "^/product/?$", "status": 301, "headers": { "Location": "/shop" } },
    { "src": "^/roll-media/?$", "status": 301, "headers": { "Location": "/category/roll-media" } },
    { "src": "^/filter-rolls/?$", "status": 301, "headers": { "Location": "/category/roll-media" } },
    { "src": "^/category/rolls?/?$", "status": 301, "headers": { "Location": "/category/roll-media" } },
    { "src": "^/collections/roll-media/?$", "status": 301, "headers": { "Location": "/category/roll-media" } },
    { "src": "^/collections/all/?$", "status": 301, "headers": { "Location": "/shop" } },
    { "src": "^/category/fiberglass-paint-arrestors/?$", "status": 301, "headers": { "Location": "/category/fiberglass-arrestors" } },
    { "src": "^/category/tacky-panel-filters/?$", "status": 301, "headers": { "Location": "/category/tacky-panels" } },
    { "src": "^/category/ceiling-filters/?$", "status": 301, "headers": { "Location": "/category/ceiling-blankets" } },
    { "src": "^/category/merv-rated-filters/?$", "status": 301, "headers": { "Location": "/category/merv-filters" } },
    { "src": "^/exhaust/?$", "status": 301, "headers": { "Location": "/exhaust-filters" } },
    { "src": "^/intake/?$", "status": 301, "headers": { "Location": "/intake-filters" } },
    { "src": "^/ceiling/?$", "status": 301, "headers": { "Location": "/ceiling-filters" } },
    { "src": "^/prefilter/?$", "status": 301, "headers": { "Location": "/prefilters" } },
    { "src": "^/pre-filters?/?$", "status": 301, "headers": { "Location": "/prefilters" } },
    { "src": "^/garmat/?$", "status": 301, "headers": { "Location": "/garmat-paint-booth-filters" } },
    { "src": "^/gfs/?$", "status": 301, "headers": { "Location": "/gfs-paint-booth-filters" } },
    { "src": "^/col-?met/?$", "status": 301, "headers": { "Location": "/col-met-paint-booth-filters" } },
    { "src": "^/neshap/?$", "status": 301, "headers": { "Location": "/neshap-compliant-paint-booth-filters" } },
    { "src": "^/method-319/?$", "status": 301, "headers": { "Location": "/neshap-compliant-paint-booth-filters" } },
    { "src": "^/(?:policies/)?refund-policy/?$", "status": 301, "headers": { "Location": "/returns" } },
    { "src": "^/(?:policies/|pages/)?shipping(?:-policy)?/?$", "status": 301, "headers": { "Location": "/terms-of-service" } },
    { "src": "^/pages/contact/?$", "status": 301, "headers": { "Location": "/contact" } },
    { "src": "^/about(?:-us)?/?$", "status": 301, "headers": { "Location": "/why-choose-us" } },
    { "src": "^/subscribe(?:-and-save)?/?$", "status": 301, "headers": { "Location": "/shop" } },
    { "src": "^/cart/?$", "status": 301, "headers": { "Location": "/shop" } },
    { "src": "^/account/?$", "status": 301, "headers": { "Location": "/auth" } },
    { "src": "^/industries/?$", "status": 301, "headers": { "Location": "/paint-booth-filters" } },
    { "src": "^/california/?$", "status": 301, "headers": { "Location": "/california/north-bay-paint-booth-filters" } },
    { "src": "^/search/?$", "status": 301, "headers": { "Location": "/filter-finder" } },
    { "src": "^/product-shell/?$", "status": 301, "headers": { "Location": "/shop" } },
    { "src": "^/(?:spraybooth-filters|spray-booth-filter)/?$", "status": 301, "headers": { "Location": "/spray-booth-filters" } },
    { "src": "^/(?:shop-by-booth/marathon|marathon-finishing|marathon-paint-booth-filters)/?$", "status": 301, "headers": { "Location": "/shop-by-booth/marathon-finishing" } },
    { "src": "^/(?:holding-grids|category/holding-grids)/?$", "status": 301, "headers": { "Location": "/product/20x20-paint-arrestor-holding-grids-w-tips-each" } },
    { "src": "^/paint-booth-filter-rolls?/?$", "status": 301, "headers": { "Location": "/category/roll-media" } },
    { "src": "^/filter-wall/?$", "status": 301, "headers": { "Location": "/paint-booth-filters" } },
    { "src": "^/collections/?$", "status": 301, "headers": { "Location": "/shop" } },
    { "src": "^/blogs(?:/.*)?$", "status": 301, "headers": { "Location": "/blog" } },
    { "src": "^/pages/about-us/?$", "status": 301, "headers": { "Location": "/why-choose-us" } },
    {
      "handle": "filesystem"
    },
    {
      "src": "/product/([^/]+)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(robots|llms|llms-full).txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/products.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
